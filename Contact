<style>
  :root{
    --bg:#0A192F;
    --bg-card:#112240;
    --text:#CCD6F6;
    --text-heading:#E6F1FF;
    --text-muted:#8892B0;
    --accent:#64FFDA;
    --border:#1D2D50;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'DM Sans',system-ui,sans-serif;
    line-height:1.7;
    font-size:16px;
  }
  a{color:var(--accent);text-decoration:none;}
  a:hover{text-decoration:underline;}
  header{
    border-bottom:1px solid var(--border);
    padding:20px 24px;
  }
  .brand{
    font-family:'Syne',sans-serif;
    font-weight:800;
    font-size:1.4rem;
    color:var(--text-heading);
  }
  .crumb{
    max-width:760px;
    margin:24px auto 0;
    padding:0 24px;
    font-size:0.9rem;
    color:var(--text-muted);
  }
  main{
    max-width:760px;
    margin:0 auto;
    padding:24px 24px 80px;
  }
  h1{
    font-family:'Syne',sans-serif;
    font-weight:800;
    font-size:2.2rem;
    color:var(--text-heading);
    margin:12px 0 8px;
  }
  .lead{
    color:var(--text-muted);
    margin-bottom:32px;
  }
  h2{
    font-family:'Syne',sans-serif;
    font-weight:700;
    font-size:1.15rem;
    color:var(--text-heading);
    margin:0 0 6px;
  }
  p{margin-bottom:14px;}
  .grid{
    display:grid;
    grid-template-columns:1fr;
    gap:16px;
    margin-bottom:32px;
  }
  @media(min-width:640px){
    .grid{grid-template-columns:1fr 1fr;}
  }
  .card{
    background:var(--bg-card);
    border:1px solid var(--border);
    border-radius:10px;
    padding:20px;
  }
  .card a{
    display:inline-block;
    margin-top:8px;
    font-weight:700;
  }
  form{
    background:var(--bg-card);
    border:1px solid var(--border);
    border-radius:10px;
    padding:24px;
  }
  label{
    display:block;
    font-size:0.9rem;
    color:var(--text-muted);
    margin-bottom:6px;
  }
  input, select, textarea{
    width:100%;
    background:#0A192F;
    border:1px solid var(--border);
    border-radius:8px;
    padding:12px 14px;
    color:var(--text);
    font-family:'DM Sans',sans-serif;
    font-size:0.95rem;
    margin-bottom:18px;
  }
  input:focus, select:focus, textarea:focus{
    outline:2px solid var(--accent);
    outline-offset:2px;
  }
  textarea{
    min-height:140px;
    resize:vertical;
  }
  button{
    background:var(--accent);
    color:#0A192F;
    border:none;
    font-weight:700;
    font-size:1rem;
    padding:12px 28px;
    border-radius:8px;
    cursor:pointer;
    font-family:'DM Sans',sans-serif;
  }
  button:hover{opacity:0.9;}
  footer{
    border-top:1px solid var(--border);
    padding:28px 24px;
    text-align:center;
    color:var(--text-muted);
    font-size:0.85rem;
  }
  footer a{margin:0 8px;}
</style>
</head>
<body>

<header>
  <a href="https://www.dailykitbox.com/" class="brand">DailyKitBox</a>
</header>

<div class="crumb"><a href="https://www.dailykitbox.com/">Home</a> / Contact</div>

<main>
  <h1>Contact Us</h1>
  <p class="lead">Found a bug, have a tool idea, or just want to say hello? Send us a message below or email us directly.</p>

  <div class="grid">
    <div class="card">
      <h2>Email</h2>
      <p>For general questions, feedback or partnership inquiries.</p>
      <a href="mailto:contact@dailykitbox.com">contact@dailykitbox.com</a>
    </div>
    <div class="card">
      <h2>Bug Reports</h2>
      <p>Tell us the tool name, your browser and what went wrong.</p>
      <a href="mailto:contact@dailykitbox.com?subject=Bug%20Report">Report a Bug</a>
    </div>
  </div>

  <form action="mailto:contact@dailykitbox.com" method="post" enctype="text/plain">
    <label for="name">Your Name</label>
    <input type="text" id="name" name="name" required>

    <label for="email">Your Email</label>
    <input type="email" id="email" name="email" required>

    <label for="topic">Topic</label>
    <select id="topic" name="topic">
      <option value="General Question">General Question</option>
      <option value="Bug Report">Bug Report</option>
      <option value="Tool Suggestion">Tool Suggestion</option>
      <option value="Partnership">Partnership</option>
    </select>

    <label for="message">Message</label>
    <textarea id="message" name="message" required></textarea>

    <button type="submit">Send Message</button>
  </form>
</main>

<footer>
  <div>© 2026 DailyKitBox. All Rights Reserved.</div>
  <div style="margin-top:8px;">
    <a href="https://www.dailykitbox.com/about/">About</a>
    <a href="https://www.dailykitbox.com/contact/">Contact</a>
    <a href="https://www.dailykitbox.com/privacy-policy/">Privacy Policy</a>
    <a href="https://www.dailykitbox.com/terms/">Terms of Service</a>
  </div>
</footer>

</body>
</html>